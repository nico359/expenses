<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.expenses</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Expenses</name>
  <summary>Track your expenses and income</summary>
  <description>
    <p>A mobile-friendly expense tracker for Linux. Manage multiple accounts, track recurring expenses, and import/export from the Android MyExpenses app.</p>
  </description>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/expenses-rs</url>
  <url type="vcs-browser">https://github.com/nico359/expenses-rs</url>
  <url type="bugtracker">https://github.com/nico359/expenses-rs/issues</url>

  <translation type="gettext">expenses</translation>
  <launchable type="desktop-id">io.github.nico359.expenses.desktop</launchable>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-03-17">
      <description translate="no">
        <p>Initial release — full rewrite in Rust</p>
        <ul>
          <li>Track expenses and income across multiple accounts</li>
          <li>Recurring expenses (daily, weekly, monthly, yearly)</li>
          <li>Import/export from MyExpenses Android app</li>
          <li>Database backup and restore</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
