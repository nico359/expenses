<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.expenses</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Expenses</name>
  <summary>Track your expenses and income</summary>
  <description>
    <p>Expenses is a mobile-friendly expense tracker for Linux. Manage multiple accounts, track recurring expenses, and import/export data from the Android MyExpenses app.</p>
  </description>

  <icon type="stock">io.github.nico359.expenses</icon>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/expenses</url>
  <url type="vcs-browser">https://github.com/nico359/expenses</url>
  <url type="bugtracker">https://github.com/nico359/expenses/issues</url>

  <recommends>
    <display_length compare="ge">360</display_length>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <supports>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <translation type="gettext">expenses</translation>
  <launchable type="desktop-id">io.github.nico359.expenses.desktop</launchable>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.3.0" date="2026-05-15">
      <description translate="no">
        <p>This release improves the account navigation experience on desktop.</p>
        <ul>
          <li>Account selector replaced with an adaptive sidebar showing account names and balances</li>
          <li>Sidebar stays visible on desktop and collapses into a navigation stack on mobile</li>
          <li>Added MyExpenses to the "Inspired by" section of the about dialog</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-04-02">
      <description translate="no">
        <p>This release adds custom recurring intervals and improves the export experience.</p>
        <ul>
          <li>Custom recurring expense intervals in days, weeks, or months</li>
          <li>Export filenames now include a timestamp</li>
          <li>Renamed "Backup for MyExpenses" to "Export for MyExpenses" to better reflect what it does</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-03-20">
      <description translate="no">
        <p>Several quality-of-life improvements in this release.</p>
        <ul>
          <li>Re-added payee autocomplete (was lost during the Rust rewrite)</li>
          <li>Auto-fill amount, note, and income toggle when selecting an autocomplete suggestion</li>
          <li>Added the ability to edit existing expenses in place</li>
          <li>Bumped GNOME runtime to version 50</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-03-18">
      <description translate="no">
        <p>First release of the Rust rewrite.</p>
        <ul>
          <li>Reworked app icon</li>
          <li>Fixed a bug where monthly recurring expenses would reappear daily</li>
          <li>Track expenses and income across multiple accounts</li>
          <li>Recurring expenses (daily, weekly, monthly, yearly)</li>
          <li>Import/export from the MyExpenses Android app</li>
          <li>Database backup and restore</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
